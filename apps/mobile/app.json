{
  "expo": {
    "name": "Lift",
    "slug": "lift",
    "version": "0.20.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lift.app"
    },
    "android": {
      "package": "com.lift.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8a625a40-8cba-4aa3-ac08-9ae4dd880d8e",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101012",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/rest_complete.wav"
          ]
        }
      ],
      "expo-image",
      "./plugins/with-theme-launcher-icons.ts",
      "./plugins/with-exact-alarms.ts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a625a40-8cba-4aa3-ac08-9ae4dd880d8e"
      }
    },
    "owner": "pawant67"
  }
}
