{
  "name": "@lift/shared",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "//": "Metro reads the source directly so edits hot-reload with no build step; Node needs compiled JS.",
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./exercises": {
      "react-native": "./src/exercises/index.ts",
      "types": "./dist/exercises/index.d.ts",
      "default": "./dist/exercises/index.js"
    },
    "./import": {
      "react-native": "./src/import/index.ts",
      "types": "./dist/import/index.d.ts",
      "default": "./dist/import/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^26.4.1"
  }
}
